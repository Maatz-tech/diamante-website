---
import { SOCIAL_LINKS, LEGAL_DOCS } from '../data/site';
import CloseIcon from './icons/CloseIcon.astro';
import BrandBar from './BrandBar.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import LinkedinIcon from './icons/LinkedinIcon.astro';
import YoutubeIcon from './icons/YoutubeIcon.astro';

const icons = {
  instagram: InstagramIcon,
  linkedin: LinkedinIcon,
  youtube: YoutubeIcon,
};
---

<footer>
  <!-- Faixa decorativa com as 4 cores da marca (invertida em relação ao topo) -->
  <BrandBar height={6} reverse />

  <!-- Faixa principal: logos + redes sociais -->
  <div
    class="container-page flex flex-col items-center gap-10 bg-white py-16 lg:flex-row lg:items-start lg:justify-between lg:gap-6 lg:py-20"
  >
    <div class="flex items-center gap-4 lg:gap-6">
      <img
        src={`${import.meta.env.BASE_URL}images/logo-diamante-color.webp`}
        alt="Diamante Energia"
        width="184"
        height="56"
        loading="lazy"
        class="h-11 w-auto lg:h-14 lg:w-[184px]"
      />
      <span aria-hidden="true" class="h-[43px] w-px bg-mute"></span>
      <img
        src={`${import.meta.env.BASE_URL}images/logo-eureca.webp`}
        alt="Eureca"
        width="164"
        height="30"
        loading="lazy"
        class="h-6 w-auto lg:h-[30px] lg:w-[164px]"
      />
    </div>

    <ul class="flex items-center gap-3.5">
      {
        SOCIAL_LINKS.map((social) => {
          const Icon = icons[social.icon];
          return (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="flex size-14 items-center justify-center rounded-full bg-off-white text-blue transition-colors hover:bg-blue hover:text-white"
              >
                <Icon class="size-6" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- Barra legal -->
  <div class="bg-off-white">
    <div
      class="container-page flex flex-col items-center justify-between gap-4 py-6 text-sm lg:flex-row"
    >
      <ul class="flex flex-wrap items-center justify-center gap-4">
        {
          LEGAL_DOCS.map((doc) => (
            <li>
              <button
                type="button"
                data-legal-open={doc.id}
                class="cursor-pointer text-[#3c3c42] underline underline-offset-2 transition-colors hover:text-blue"
              >
                {doc.label}
              </button>
            </li>
          ))
        }
      </ul>

      <p class="flex items-center gap-2 text-stone">
        <span>Desenvolvido por</span>
        <img
          src={`${import.meta.env.BASE_URL}images/logo-maatz.svg`}
          alt="Maatz"
          width="72"
          height="18"
          loading="lazy"
          class="h-[18px] w-[72px]"
        />
      </p>
    </div>
  </div>

  <!-- Modais legais -->
  {
    LEGAL_DOCS.map((doc) => (
      <dialog
        id={`legal-${doc.id}`}
        class="legal-modal"
        aria-labelledby={`legal-${doc.id}-title`}
      >
        <div class="legal-modal__inner">
          <header class="legal-modal__head">
            <div>
              <h2 id={`legal-${doc.id}-title`} class="h3">
                {doc.label}
              </h2>
              <p class="mt-1 text-sm text-stone">
                Última atualização: {doc.updatedAt}
              </p>
            </div>
            <button
              type="button"
              data-legal-close
              class="flex size-10 shrink-0 items-center justify-center rounded-full text-navy transition-colors hover:bg-off-white"
              aria-label="Fechar"
            >
              <CloseIcon class="size-5" />
            </button>
          </header>
          <div class="legal-modal__body">
            {doc.body.map((p) => (
              <p class="whitespace-pre-line text-base/[1.5] text-[#3c3c42]">{p}</p>
            ))}
          </div>
        </div>
      </dialog>
    ))
  }
</footer>

<style>
  .legal-modal {
    width: min(680px, calc(100vw - 32px));
    max-height: calc(100vh - 64px);
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 24px;
    background: #fff;
    overflow: hidden;
  }
  .legal-modal::backdrop {
    background: rgba(0, 9, 41, 0.6);
    backdrop-filter: blur(4px);
  }
  .legal-modal__inner {
    display: flex;
    max-height: calc(100vh - 64px);
    flex-direction: column;
  }
  .legal-modal__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 24px 16px;
    border-bottom: 1px solid var(--color-mute);
  }
  .legal-modal__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    padding: 24px;
  }
</style>

<script>
  const openers = document.querySelectorAll<HTMLElement>('[data-legal-open]');

  openers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-legal-open');
      const modal = document.getElementById(
        `legal-${id}`
      ) as HTMLDialogElement | null;
      if (!modal) return;
      modal.showModal();
      modal.querySelector<HTMLElement>('[data-legal-close]')?.focus();

      const close = () => modal.close();
      modal
        .querySelector('[data-legal-close]')
        ?.addEventListener('click', close, { once: true });
      // clique no backdrop (fora do conteúdo) fecha
      modal.addEventListener(
        'click',
        (e) => {
          if (e.target === modal) close();
        },
        { once: true }
      );
    });
  });
</script>

---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
  class?: string;
}

const { icon, title, description, class: className = '' } = Astro.props;
---

<article
  data-card
  class={`card group/card flex h-full flex-col gap-10 p-6 transition-transform duration-300 ease-out will-change-transform hover:scale-[1.03] ${className}`}
>
  <span
    class="flex w-fit items-center justify-center rounded-xl bg-blue p-3 text-white"
  >
    <Icon name={icon} class="size-6" />
  </span>

  <div class="flex flex-col gap-3 text-[#3c3c42]">
    <h3 class="text-xl/[1.2] font-medium">{title}</h3>
    <p class="text-base/[1.25]">{description}</p>
  </div>
</article>

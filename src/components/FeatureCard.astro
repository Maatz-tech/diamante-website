---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
  class?: string;
}

const { icon, title, description, class: className = '' } = Astro.props;
---

<article
  data-card
  class={`card group/card flex h-full flex-col gap-10 border border-transparent p-6 transition-[transform,border-color,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform hover:-translate-y-1.5 hover:border-blue/15 hover:shadow-[0_12px_30px_rgba(21,41,109,0.08)] ${className}`}
>
  <span
    class="flex w-fit items-center justify-center rounded-xl bg-blue p-3 text-white"
  >
    <Icon name={icon} class="size-6" />
  </span>

  <div class="flex flex-col gap-3 text-[#3c3c42]">
    <h3 class="text-xl/[1.2] font-medium">{title}</h3>
    <p class="text-base/[1.25]">{description}</p>
  </div>
</article>

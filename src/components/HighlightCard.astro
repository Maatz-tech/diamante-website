---
interface Props {
  label: string;
  value: string;
  /** `soft` = borda quase invisível (hero) · `outlined` = borda azul (seções claras) */
  variant?: 'soft' | 'outlined';
  /** `lg` destaca o valor (usado no card de prazo, 24px no Figma). */
  size?: 'md' | 'lg';
}

const { label, value, variant = 'soft', size = 'md' } = Astro.props;

const borderClass =
  variant === 'outlined' ? 'border-blue' : 'border-[rgba(242,243,248,0.8)]';

const valueClass = size === 'lg' ? 'text-2xl/[1.2]' : 'text-xl/[1.2]';
---

<div
  data-card
  class={`card flex h-full flex-col justify-center border ${borderClass} p-6 text-center`}
>
  <p class="text-lg/[1.2] text-navy">{label}</p>
  <p class={`mt-2 font-medium text-navy ${valueClass}`}>{value}</p>
</div>

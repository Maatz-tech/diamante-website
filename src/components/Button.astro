---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'on-brand' | 'hero';
  /** Ocupa 100% da largura do container (usado no mobile). */
  block?: boolean;
  type?: 'button' | 'submit';
  class?: string;
}

const {
  href,
  variant = 'primary',
  block = false,
  type = 'button',
  class: className = '',
} = Astro.props;

const variantClass = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-outline',
  'on-brand': 'btn-on-brand',
  hero: 'btn-hero',
}[variant];

const classes = ['btn', variantClass, block ? 'w-full' : '', className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}

---
import { APPLY_URL, HIGHLIGHTS } from '../../data/site';
import Button from '../Button.astro';
import HighlightCard from '../HighlightCard.astro';

const base = import.meta.env.BASE_URL;
const img = (p: string) => `${base}${p.replace(/^\//, '')}`;
---

<section
  id="topo"
  class="bg-hero-gradient relative isolate overflow-hidden lg:h-[692px]"
>
  <!-- Decorações de fundo -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <img
      src={img('images/line-shape.webp')}
      alt=""
      width="2800"
      height="1955"
      class="absolute -left-[877px] -top-[378px] w-[2515px] max-w-none opacity-30"
    />
    <img
      src={img('images/line-shape.webp')}
      alt=""
      width="2800"
      height="1955"
      class="absolute -top-[364px] left-[212px] w-[2515px] max-w-none -scale-y-100 opacity-30"
    />
    <img
      src={img('images/texture.webp')}
      alt=""
      width="480"
      height="600"
      class="absolute inset-0 size-full object-cover opacity-10 mix-blend-multiply"
    />
    <!-- Manchas de luz radiais (sutis, como no Figma) -->
    <img
      src={img('images/ellipse-2.svg')}
      alt=""
      width="702"
      height="524"
      class="absolute -left-[412px] -top-[82px] w-[702px] max-w-none opacity-40"
    />
    <img
      src={img('images/ellipse-1.svg')}
      alt=""
      width="702"
      height="800"
      class="absolute left-[321px] top-12 hidden w-[702px] max-w-none opacity-40 lg:block"
    />
    <!-- Leque/círculo dourado: no desktop ancorado à direita, com o pico na
         borda e ~50% para fora. Empilhado no mobile fica centralizado embaixo. -->
    <img
      src={img('images/hero-shape.svg')}
      alt=""
      width="1470"
      height="562"
      class="absolute bottom-0 right-0 w-[880px] max-w-none translate-x-1/2 lg:w-[clamp(1040px,105vw,1470px)]"
    />
  </div>

  <div
    class="container-page relative flex flex-col lg:h-full lg:flex-row lg:items-start lg:justify-between lg:gap-4"
  >
    <!-- Bloco de título e CTA -->
    <div class="pt-[120px] lg:w-[38%] lg:max-w-[450px] lg:shrink-0 lg:pt-[178px]">
      <!-- Lockup: PROGRAMA / TRAINEE / DIAMANTE ENERGIA -->
      <h1 class="text-white">
        <span class="hero-kicker block">Programa</span>
        <img
          src={img('images/logo-trainee.webp')}
          alt="Trainee"
          width="440"
          height="102"
          fetchpriority="high"
          class="trainee-mark max-w-[326px] lg:max-w-full xl:max-w-[440px]"
        />
        <span class="hero-kicker-strong block">Diamante Energia</span>
      </h1>

      <p class="mt-8 text-lg/[1.2] font-bold text-white lg:mt-10 lg:text-xl/[1.2]">
        Lidere a energia que move o futuro!
      </p>
      <p class="mt-4 text-base/[1.2] text-white lg:text-lg/[1.2]">
        Desenvolva a sua carreira em uma operação estratégica para o futuro da
        energia.
      </p>

      <Button href={APPLY_URL} variant="hero" class="mt-10">
        Inscreva-se agora
      </Button>
    </div>

    <!-- Cards de destaque -->
    <ul
      class="relative z-10 mt-8 flex flex-col gap-6 lg:mt-0 lg:w-[248px] lg:shrink-0 lg:self-end lg:pb-20 xl:w-[282px]"
    >
      {
        HIGHLIGHTS.map((item) => (
          <li>
            <HighlightCard label={item.label} value={item.value} />
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Foto principal: proporção natural (nunca corta nem distorce), escala
       pela altura. Encerra a seção no mobile; absoluta no desktop, sobrepondo
       com as bordas transparentes. -->
  <img
    src={img('images/hero-photo.webp')}
    srcset={`${img('images/hero-photo-sm.webp')} 640w, ${img('images/hero-photo.webp')} 1125w`}
    sizes="(min-width: 1024px) 480px, 300px"
    alt="Trainee da Diamante Energia com capacete e equipamentos de segurança"
    width="418"
    height="591"
    fetchpriority="high"
    class="mx-auto mt-6 block h-[380px] w-auto max-w-none object-bottom lg:absolute lg:bottom-0 lg:left-[calc(50%+34px)] lg:mt-0 lg:h-[clamp(480px,46vw,591px)] lg:-translate-x-1/2"
  />
</section>

---
import { APPLY_URL, HIGHLIGHTS } from '../../data/site';
import Button from '../Button.astro';
import HighlightCard from '../HighlightCard.astro';

const base = import.meta.env.BASE_URL;
const img = (p: string) => `${base}${p.replace(/^\//, '')}`;
---

<section
  id="topo"
  class="bg-hero-gradient relative isolate overflow-hidden xl:h-[692px]"
>
  <!-- Decorações de fundo -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <img
      src={img('images/line-shape.webp')}
      alt=""
      width="2048"
      height="1430"
      class="absolute -left-[877px] -top-[378px] w-[2515px] max-w-none opacity-30"
    />
    <img
      src={img('images/line-shape.webp')}
      alt=""
      width="2048"
      height="1430"
      class="absolute -top-[364px] left-[212px] w-[2515px] max-w-none -scale-y-100 opacity-30"
    />
    <img
      src={img('images/texture.webp')}
      alt=""
      width="480"
      height="600"
      class="absolute inset-0 size-full object-cover opacity-10 mix-blend-multiply"
    />
    <!-- Manchas de luz radiais (sutis, como no Figma) -->
    <img
      src={img('images/ellipse-2.svg')}
      alt=""
      width="702"
      height="524"
      class="absolute -left-[412px] -top-[82px] w-[702px] max-w-none opacity-40"
    />
    <img
      src={img('images/ellipse-1.svg')}
      alt=""
      width="702"
      height="800"
      class="absolute left-[321px] top-12 hidden w-[702px] max-w-none opacity-40 xl:block"
    />
    <!-- Leque/círculo dourado atrás da foto. Simétrico e completo: em telas
         largas o círculo aparece inteiro (centralizado) em vez de cortar. -->
    <img
      src={img('images/hero-shape.svg')}
      alt=""
      width="1470"
      height="562"
      class="absolute bottom-0 left-1/2 w-[760px] max-w-none -translate-x-1/2 xl:left-auto xl:right-0 xl:w-[1470px] xl:translate-x-1/2"
    />
  </div>

  <div
    class="container-page relative flex flex-col xl:h-full xl:flex-row xl:items-start xl:justify-between"
  >
    <!-- Bloco de título e CTA -->
    <div class="pt-[120px] xl:w-[450px] xl:shrink-0 xl:pt-[178px]">
      <!-- Lockup: PROGRAMA / TRAINEE / DIAMANTE ENERGIA -->
      <h1 class="text-white">
        <span class="hero-kicker block">Programa</span>
        <img
          src={img('images/logo-trainee.webp')}
          alt="Trainee"
          width="440"
          height="102"
          fetchpriority="high"
          class="trainee-mark max-w-[326px] lg:max-w-[440px]"
        />
        <span class="hero-kicker-strong block">Diamante Energia</span>
      </h1>

      <p class="mt-8 text-lg/[1.2] font-bold text-white lg:mt-10 lg:text-xl/[1.2]">
        Lidere a energia que move o futuro!
      </p>
      <p class="mt-4 text-base/[1.2] text-white lg:text-lg/[1.2]">
        Desenvolva a sua carreira em uma operação estratégica para o futuro da
        energia.
      </p>

      <Button href={APPLY_URL} variant="hero" class="mt-10">
        Inscreva-se agora
      </Button>
    </div>

    <!-- Cards de destaque -->
    <ul
      class="relative z-10 mt-8 flex flex-col gap-6 xl:mt-0 xl:w-[282px] xl:shrink-0 xl:self-end xl:pb-20"
    >
      {
        HIGHLIGHTS.map((item) => (
          <li>
            <HighlightCard label={item.label} value={item.value} />
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Foto principal: encerra a seção no mobile; absoluta no desktop -->
  <div
    class="mx-auto mt-6 h-[374px] w-[300px] overflow-hidden xl:absolute xl:bottom-0 xl:left-[calc(50%+34px)] xl:mt-0 xl:h-[591px] xl:w-[418px] xl:-translate-x-1/2"
  >
    <img
      src={img('images/hero-photo.webp')}
      srcset={`${img('images/hero-photo-sm.webp')} 640w, ${img('images/hero-photo.webp')} 1125w`}
      sizes="(min-width: 1280px) 418px, 300px"
      alt="Trainee da Diamante Energia com capacete e equipamentos de segurança"
      width="418"
      height="591"
      fetchpriority="high"
      class="size-full scale-[1.15] object-cover object-top"
    />
  </div>
</section>

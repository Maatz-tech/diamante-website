---
import SectionHeader from '../SectionHeader.astro';
import HighlightCard from '../HighlightCard.astro';
import Button from '../Button.astro';
import PlayIcon from '../icons/PlayIcon.astro';
import { HIGHLIGHTS, VIDEO_EMBED_URL } from '../../data/site';

const hasVideo = VIDEO_EMBED_URL.length > 0;
---

<section id="a-empresa" class="bg-white">
  <div class="container-page flex flex-col gap-8 py-16 lg:gap-12 lg:py-20">
    <SectionHeader
      eyebrow="A Diamante Energia"
      title="Energia para transformar. Pessoas para fazer acontecer."
    />

    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-20">
      <!-- Coluna de texto: no mobile vai depois da mídia -->
      <div class="order-2 flex flex-col gap-8 lg:order-1 lg:w-[500px] lg:shrink-0 lg:gap-10">
        <div class="flex flex-col gap-4 text-base/[1.25] text-[#3c3c42]">
          <p>
            Na <strong class="font-medium text-navy">Diamante Energia</strong>,
            acreditamos que o futuro da energia começa com pessoas preparadas para
            inovar.
          </p>
          <p>
            Somos uma das principais empresas de geração de energia do Brasil,
            responsáveis pela gestão do Complexo Termelétrico Jorge Lacerda (SC) e
            de Energia Pecém (CE), com 1.460 MW de capacidade instalada e atuação
            estratégica para a segurança energética do país.
          </p>
          <p>
            Investimos em pesquisa, inovação e novas tecnologias para impulsionar
            e acompanhar a evolução do setor elétrico, desenvolvendo projetos que
            ajudam a construir uma matriz energética cada vez mais sustentável.
          </p>
          <p>Agora, queremos contar com novos talentos nessa jornada.</p>
          <p>
            Se você é movido por desafios, tem vontade de aprender, colaborar e
            fazer a diferença, o Programa Trainee Diamante Energia pode ser o
            início de uma carreira com propósito, desenvolvimento e grandes
            oportunidades.
          </p>
          <p class="text-lg font-bold text-navy">
            O futuro da energia também pode começar com você.
          </p>
        </div>

        <Button href="#o-programa" class="self-start">Conheça o Programa</Button>
      </div>

      <!-- Mídia + cards -->
      <div class="order-1 flex flex-col gap-6 lg:order-2 lg:min-w-0 lg:flex-1">
        <button
          type="button"
          data-video-open
          disabled={!hasVideo}
          class="group relative block aspect-video w-full cursor-pointer overflow-hidden rounded-3xl disabled:cursor-default"
          aria-label="Assistir ao vídeo institucional da Diamante Energia"
        >
          <img
            src={`${import.meta.env.BASE_URL}images/sobre-video.webp`}
            data-reveal-img
            srcset={`${import.meta.env.BASE_URL}images/sobre-video-sm.webp 680w, ${import.meta.env.BASE_URL}images/sobre-video.webp 1280w`}
            sizes="(min-width: 1024px) 590px, 327px"
            alt=""
            width="1280"
            height="720"
            loading="lazy"
            class="size-full object-cover"
          />
          <span
            class="absolute left-1/2 top-1/2 flex size-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-[rgba(51,42,222,0.1)] text-white backdrop-blur-sm transition-transform group-hover:scale-110"
          >
            <PlayIcon class="size-8" />
          </span>
        </button>

        <ul class="grid gap-6 sm:grid-cols-2">
          {
            HIGHLIGHTS.map((item) => (
              <li>
                <HighlightCard
                  label={item.label}
                  value={item.value}
                  variant="outlined"
                  size={item.size ?? 'md'}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  {
    hasVideo && (
      <dialog
        id="video-modal"
        class="video-modal"
        data-src={VIDEO_EMBED_URL}
        aria-label="Vídeo institucional da Diamante Energia"
      >
        <div class="video-modal__inner">
          <button
            type="button"
            data-video-close
            class="video-modal__close"
            aria-label="Fechar vídeo"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
          <div class="video-modal__frame">
            <iframe
              title="Vídeo institucional da Diamante Energia"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        </div>
      </dialog>
    )
  }
</section>

<style>
  .video-modal {
    width: min(960px, 92vw);
    max-width: 92vw;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }
  .video-modal::backdrop {
    background: rgba(0, 9, 41, 0.8);
    backdrop-filter: blur(4px);
  }
  .video-modal__inner {
    position: relative;
  }
  .video-modal__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .video-modal__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-modal__close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: #fff;
    color: var(--color-navy);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s ease;
  }
  .video-modal__close:hover {
    transform: scale(1.08);
  }
  .video-modal__close svg {
    width: 20px;
    height: 20px;
  }
  @media (max-width: 640px) {
    .video-modal__close {
      top: -46px;
      right: 0;
      color: #fff;
      background: rgba(255, 255, 255, 0.15);
    }
  }
</style>

<script>
  const modal = document.getElementById('video-modal') as HTMLDialogElement | null;

  if (modal) {
    const iframe = modal.querySelector('iframe')!;
    const src = modal.dataset.src ?? '';
    const openers = document.querySelectorAll('[data-video-open]');

    const open = () => {
      // separador correto caso a URL já tenha query string
      const sep = src.includes('?') ? '&' : '?';
      iframe.src = `${src}${sep}autoplay=1`;
      modal.showModal();
    };

    const close = () => {
      modal.close();
      iframe.src = ''; // para o vídeo ao fechar
    };

    openers.forEach((btn) => btn.addEventListener('click', open));
    modal.querySelector('[data-video-close]')?.addEventListener('click', close);

    // clique no backdrop (fora do conteúdo) fecha
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    // ESC nativo do <dialog> também dispara o cleanup do iframe
    modal.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
  }
</script>
